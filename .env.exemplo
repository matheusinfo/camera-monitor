CAM_HOST=
CAM_USER=
CAM_PASS=
CAM_RTSP_PORT=554
CAM_ONVIF_PORT=5000
# onvif1 = 1080p com audio; onvif2 = substream 640x360 sem audio (Raspberry Pi)
CAM_PATH=onvif1
# So quando CAM_PATH nao tem audio: caminho de onde puxar o audio (ex.: onvif1)
CAM_AUDIO_PATH=
CLOUDFLARE_TUNNEL_TOKEN=
APP_USER=seu_usuario
APP_PASS=troque_por_uma_senha_forte
# Atras do Cloudflare Access: com estes dois, vale so o login do Access e
# APP_USER/APP_PASS sao ignorados. AUD fica em Access > Applications > (app) > Overview.
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# Push no celular pelo app ntfy. O topico funciona como senha: use um nome aleatorio.
NTFY_URL=
# ntfy proprio com login: token de acesso (tk_...) com escrita no topico. Vazio = sem login.
NTFY_TOKEN=
# Endereco publico do painel; tocar na notificacao abre o ao vivo
PUBLIC_URL=
# Heartbeat: GET nesta URL a cada 5 min enquanto o video chega (ex.: check do
# healthchecks.io, period 5 min, grace 10 min). Se o aparelho cair, o servico
# avisa. Vazio desliga.
HEARTBEAT_URL=
# Segundos sem ver a pessoa ate a visita acabar (padrao 90). Um push por visita.
# VISITA_FIM_S=90

# Custo da deteccao. Padrao: 0 (todas as threads) e 0.4s. Pi 3: 2 e 2.
DETECT_THREADS=
DETECT_INTERVAL_S=
# Tamanho (px, miniatura 160x90) da maior mancha de movimento para rodar a
# deteccao; ignora chuva. 0 = sempre. Padrao 40
MOTION_BLOB=
# 1 = tambem analisa recortes do quadro (acha pessoa pequena ou atras de grade). ~13x mais CPU.
DETECT_TILES=

# Somente para WSL2, junto de compose.wsl.yaml.
# Descubra com: ip route | awk '/default/{print $3}'
WINDOWS_HOST=192.168.250.1

# Detector: yolox (padrao, YOLOX-Tiny) ou mobilenet (o antigo, usado no Pi 3)
# DETECT_MODEL=yolox
# Confianca minima para alerta de pessoa (padrao 0.35 no YOLOX, 0.25 no
# MobileNet). Suba se houver falso alarme; o log mostra a confianca de cada
# pessoa vista.
# PESSOA_MIN=0.35
# Pessoa com a base da caixa acima dessa fracao da altura esta na rua (moto,
# carro pela grade) e nao avisa. Depende do enquadramento; 0 desliga.
# PESSOA_BASE_MIN=0.7

# Carro parado: avisa quando um veiculo fica tantos segundos no mesmo lugar, em
# qualquer ponto da imagem (garagem, rampa, rua). Carro que so passa na rua nao
# fica parado e nao avisa. Vazio ou 0 desliga; 20 e um bom valor. O log mostra
# cada veiculo visto, com a confianca.
CARRO_PARADO_S=
# Confianca minima para contar um veiculo (padrao 0.5)
CARRO_MIN=
