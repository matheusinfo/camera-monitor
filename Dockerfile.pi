# Imagem para Raspberry Pi 32 bits (armv7). O PyPI nao tem wheel de opencv/numpy
# para armv7 e compilar num Pi 3 leva horas, entao usamos os pacotes do Debian.
FROM debian:bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# Tambem serve para a Echo Show com techo5 (userland armhf). Sandbox do apt como
# root: o kernel Android dela tem CONFIG_ANDROID_PARANOID_NETWORK, que so deixa
# root ou o grupo 3003 abrir sockets, e o usuario _apt fica sem DNS.
RUN apt-get -o APT::Sandbox::User=root update \
    && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends ffmpeg ca-certificates curl \
       python3 python3-numpy python3-opencv python3-flask python3-jwt python3-cryptography gunicorn \
    && rm -rf /var/lib/apt/lists/*

ARG MEDIAMTX_VERSION=v1.21.1
RUN curl -fsSL "https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VERSION}/mediamtx_${MEDIAMTX_VERSION}_linux_armv7.tar.gz" \
    | tar -xz -C /usr/local/bin mediamtx

WORKDIR /app
COPY server.py config.py ptz.py gunicorn.conf.py MobileNetSSD_deploy.prototxt MobileNetSSD_deploy.caffemodel ./
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
